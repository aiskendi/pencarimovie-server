{
    frankenphp {
        # 8 threads balances two constraints:
        #   - Memory: each PHP thread can hold 30-50MB once MadelineProto is
        #     loaded, so 8 stays within a 1GB-RAM device's budget.
        #   - Concurrency: /manifest.json and /catalog/* make blocking
        #     WordPress calls (12s timeout). At 4 threads those calls occupy
        #     the whole pool and C=100 returned 0 OK; 8 gives enough headroom
        #     to keep serving while a few upstream calls are in flight.
        #
        # Requests no longer save the MadelineProto session:
        # fd_boot_madeline() clears FD_FORCE_FULL_BOOT right after
        # construction, so every boot takes the IPC client path where
        # APIWrapper::serialize() returns early. Previously each request did a
        # full-mode save holding an exclusive flock on safe.php.lock and
        # lightState.php.lock, which serialized all requests and wedged the
        # server permanently.
        #
        # Do NOT use `max_threads auto`: autoscaling spawns threads that all
        # contend on the same WordPress call and session lock, which measured
        # WORSE than a fixed pool (98 vs 322 successful requests at C=50).
        num_threads 8

        # Cap how long a request waits for a free thread. Without this the
        # default is "disabled", so a saturated pool makes requests hang
        # indefinitely instead of failing fast. 30s is above the slowest
        # legitimate upstream call (WordPress search-music, 15s timeout).
        max_wait_time 30s
    }
    order php_server before file_server
}

# NOTE: keep this as a bare `:8088` port, NOT `localhost:8088`.
#
# Caddy only enables automatic HTTPS for site blocks with a HOSTNAME. A bare
# `:8088` is treated as a plain HTTP listener, which is exactly what this
# project needs:
#   - Stremio/Nuvio install an `http://` transport URL for LAN/localhost.
#     An HTTPS redirect would break addon installation.
#   - Caddy's local CA is not trusted by Stremio, Nuvio, or Android, so a
#     self-signed cert would fail TLS validation on every client.
#   - Android/Termux often has no working CA bundle at all.
#   - HTTPS is already available when needed via the Cloudflare tunnel
#     (POST /api/tunnel/enable), which serves a publicly-trusted cert.
#
# Changing this to `localhost:8088` would silently enable auto-HTTPS and
# redirect HTTP -> HTTPS, breaking every LAN client.
:8088 {
	root * .
	encode zstd gzip

	# Security: block direct HTTP access to internal directories, hidden files, and source configs
	@blocked path /storage/* /vendor/* /bin/* /patches/* /src/* /.* /Caddyfile* /*.sh /*.bat /*.key /*.log /*.lock /*.md /*.yml /*.yaml /composer.json /package.json
	error @blocked 404

	# Tune for low-end / 1GB RAM devices:
	# Disable symlink resolution to save filesystem syscalls on slow flash/eMMC storage
	# Rewrite 32-hex token prefixes directly to index.php (e.g. /<token>/manifest.json -> /index.php)
	# so FrankenPHP handles the tokenized route instead of failing try_files on disk.
	@tokenized path_regexp token ^/[0-9a-fA-F]{32}(/.*)?$
	rewrite @tokenized index.php

	php_server {
		resolve_root_symlink false
		try_files {path} index.php
	}
}
