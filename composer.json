{
  "name": "pencarimovie/downloader",
  "description": "Local browser-based Telegram downloader with MadelineProto streaming.",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "cweagans/composer-patches": "^1.7",
    "danog/madelineproto": "^8.4"
  },
  "extra": {
    "patches": {
      "danog/madelineproto": {
        "Fix Windows IPC stream_socket_server notice": "patches/madelineproto-windows-ipc.patch"
      },
      "danog/ipc": {
        "Prefer TCP loopback IPC server": "patches/ipc-tcp-default.patch"
      }
    }
  },
  "autoload": {
    "psr-4": {
      "TGFastDownloader\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "cweagans/composer-patches": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
