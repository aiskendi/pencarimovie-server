# ---------------------------------------------------------------------------
# Android projects tracked for CI (must stay at the end of this file).
#
# These negations have to come after every broad rule above, because git does
# not descend into an excluded directory and evaluates patterns in order.
# ---------------------------------------------------------------------------

# Re-include the two projects the APK workflow builds.
!android/termux-app-fork/
!android/termux-app-fork-x86_64/

# Sources live under com/pencarimovie/, which `pencarimovie*` would exclude.
!android/termux-app-fork/app/main/java/com/pencarimovie/
!android/termux-app-fork/app/main/java/com/pencarimovie/**
!android/termux-app-fork-x86_64/app/main/java/com/pencarimovie/
!android/termux-app-fork-x86_64/app/main/java/com/pencarimovie/**

# Bootstrap ZIPs are build inputs, not release artifacts.
!android/termux-app-fork/app/main/assets/
!android/termux-app-fork/app/main/assets/*.zip
!android/termux-app-fork-x86_64/app/main/assets/
!android/termux-app-fork-x86_64/app/main/assets/*.zip

# Signing keystores — development keys, already public in this project's
# history. CI needs them to sign the release APK.
!android/termux-app-fork/app/*.jks
!android/termux-app-fork-x86_64/app/*.jks

# Keep build output and IDE state out even inside the tracked projects.
android/termux-app-fork/build/
android/termux-app-fork/app/build/
