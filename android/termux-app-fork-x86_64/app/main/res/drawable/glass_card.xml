<?xml version="1.0" encoding="utf-8"?>
<!--
  Frosted-glass card: a translucent white fill over the near-black background,
  with a hairline light border and a soft corner radius. Used for the update
  banner and the log panel.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_border" />
    <corners android:radius="16dp" />
</shape>
