dist/_
!dist/pencarimovie-downloader-linux-_.tar.gz

# Dockerfile.release COPYs the PREBUILT glibc binary from here. It must stay in the

# build context: `dist/*` does not match `dist-docker/`, but an over-broad ignore

# would break the image build with a confusing "COPY failed: no source files".

!dist-docker/
!dist-docker/\*\*/pencarimovie-server
pkgroot/
target/

# The native build keeps live state (sessions, auth.json, api_secret.key) and

# local build output inside the crate; never ship any of it into an image.

storage/
dist/
dist-native/
target/
tests/
node*modules/
.git/
android/
termux-packages/
libtalloc_extract/
php_extract/
proot/
storage/*
!storage/.gitkeep
_.zip
_.deb
\_.apk
