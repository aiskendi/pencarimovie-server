# syntax=docker/dockerfile:1
#
# Runtime image for the PUBLISHED multi-arch container. It packages a PREBUILT
# binary — there is deliberately no toolchain, no cargo, no source here.
#
#   docker build -f Dockerfile.release --build-arg ARCH=amd64 -t pm:native-amd64 .
#   docker build -f Dockerfile.release --build-arg ARCH=arm64 -t pm:native-arm64 .
#
# ARCH MUST BE `amd64` or `arm64`, and the binary in `dist-docker/${ARCH}/` is the
# SAME file the `pencarimovie-server-<os>-<arch>.tar.gz` ships, i.e. the GNU/glibc
# build of the crate.
#
# ── WHY THIS IS NO LONGER alpine+musl (2026-10-31) ──────────────────────────
# The image used to carry a second, statically-linked musl build. Measured on a
# CPU with AVX/AVX2 removed, that binary executed `vmovd %eax,%xmm0` — plain AVX,
# no feature check — while the glibc build of the same commit was clean and served
# fine. The AVX came in with the static musl libc (Ubuntu's musl-tools), not with
# our crates, and it is exactly the 3.0.x `exit 132` that killed the app on every
# Synology x86 NAS (Atom/Celeron: no AVX). One artifact, one toolchain, one thing
# for the release gate to prove.
#
# Cost of the change: ~40 MB larger image (debian-slim instead of alpine). Benefit:
# the container runs the binary we can actually verify.
#
# ENV/EXPOSE/VOLUME/USER/HEALTHCHECK/CMD are kept byte-compatible with
# `Dockerfile` so Heroku, Render (render.yaml -> ghcr.io/...:native) and
# docker-compose observe exactly the same container contract.

FROM debian:bookworm-slim

ARG ARCH=amd64

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata curl \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --home-dir /data --shell /usr/sbin/nologin pencarimovie \
 && mkdir -p /data \
 && chown -R 10001:10001 /data

# The release workflow stages the release binary here before building, so the
# build context stays tiny (a few MB) instead of shipping the whole repo.
COPY dist-docker/${ARCH}/pencarimovie-server /usr/local/bin/pencarimovie-server
RUN chmod +x /usr/local/bin/pencarimovie-server

ENV PM_APP_ROOT=/data \
    PM_LISTEN_HOST=0.0.0.0 \
    PORT=8088

EXPOSE 8088
VOLUME ["/data"]
USER 10001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD curl -fsS "http://127.0.0.1:${PORT}/api/version" >/dev/null || exit 1

CMD ["pencarimovie-server"]
